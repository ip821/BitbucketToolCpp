<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<resource xmlns="http://www.wxwidgets.org/wxxrc" version="2.5.3.0">
  <object class="wxPanel" name="LoginViewBase">
    <style>wxTAB_TRAVERSAL</style>
    <object class="wxBoxSizer" name="bSizer1">
      <orient>wxVERTICAL</orient>
      <object class="sizeritem">
        <flag>wxEXPAND</flag>
        <border>5</border>
        <option>1</option>
        <object class="wxFlexGridSizer" name="fgSizer1">
          <vgap>0</vgap>
          <hgap>0</hgap>
          <growablerows></growablerows>
          <growablecols>1</growablecols>
          <rows>0</rows>
          <cols>2</cols>
          <object class="sizeritem">
            <flag>wxALL|wxALIGN_CENTER_VERTICAL</flag>
            <border>5</border>
            <option>0</option>
            <object class="wxStaticText" name="m_staticText1">
              <label>Login:</label>
              <wrap>-1</wrap>
            </object>
          </object>
          <object class="sizeritem">
            <flag>wxALL|wxEXPAND</flag>
            <border>5</border>
            <option>0</option>
            <object class="wxTextCtrl" name="m_pLoginTextCtrl">
              <value></value>
              <maxlength>0</maxlength>
            </object>
          </object>
          <object class="sizeritem">
            <flag>wxALL|wxALIGN_CENTER_VERTICAL</flag>
            <border>5</border>
            <option>0</option>
            <object class="wxStaticText" name="m_staticText2">
              <label>Password:</label>
              <wrap>-1</wrap>
            </object>
          </object>
          <object class="sizeritem">
            <flag>wxALL|wxEXPAND</flag>
            <border>5</border>
            <option>0</option>
            <object class="wxTextCtrl" name="m_pPasswordTextCtrl">
              <style>wxTE_PASSWORD</style>
              <value></value>
              <maxlength>0</maxlength>
            </object>
          </object>
        </object>
      </object>
      <object class="sizeritem">
        <flag>wxALL|wxALIGN_CENTER_HORIZONTAL</flag>
        <border>5</border>
        <option>0</option>
        <object class="wxStaticText" name="m_pErrorStaticText">
          <fg>#ff0000</fg>
          <hidden>1</hidden>
          <font>
            <size>9</size>
            <style>normal</style>
            <weight>normal</weight>
            <family>swiss</family>
            <underlined>0</underlined>
            <face>Arial</face>
          </font>
          <label>Error text</label>
          <wrap>-1</wrap>
        </object>
      </object>
      <object class="sizeritem">
        <flag>wxALL|wxALIGN_CENTER_HORIZONTAL</flag>
        <border>5</border>
        <option>0</option>
        <object class="wxActivityIndicator" name="m_pActivityIndicator"/>
      </object>
    </object>
  </object>
  <object class="wxPanel" name="WorkspaceViewBase">
    <style>wxTAB_TRAVERSAL</style>
    <object class="wxBoxSizer" name="bSizer2">
      <orient>wxVERTICAL</orient>
      <object class="sizeritem">
        <flag>wxALL|wxEXPAND</flag>
        <border>5</border>
        <option>1</option>
        <object class="wxCheckListBox" name="m_pListBox">
          <content/>
        </object>
      </object>
      <object class="sizeritem">
        <flag>wxALL|wxALIGN_CENTER_HORIZONTAL</flag>
        <border>5</border>
        <option>0</option>
        <object class="wxActivityIndicator" name="m_pActivityIndicator"/>
      </object>
    </object>
  </object>
  <object class="wxPanel" name="RepositoryViewBase">
    <style>wxTAB_TRAVERSAL</style>
    <object class="wxBoxSizer" name="bSizer3">
      <orient>wxVERTICAL</orient>
      <object class="sizeritem">
        <flag>wxALL|wxEXPAND</flag>
        <border>5</border>
        <option>1</option>
        <object class="wxCheckListBox" name="m_pListBox">
          <content/>
        </object>
      </object>
    </object>
  </object>
</resource>
